{
  "name": "private-guide",
  "version": "1.3.0",
  "description": "私人 AI 导游 — 本地服务（Node 运行时已内置，双击即用）",
  "bin": "index.js",
  "pkg": {
    "scripts": [
      "*.js",
      "services/*.js"
    ],
    "assets": [
      "../web/**/*",
      "node_modules/msedge-tts/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "../dist"
  }
}
