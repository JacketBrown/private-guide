# ============================================
# 私人 AI 导游 App — 服务端配置模板
# 复制本文件为 .env 并填入真实值
#
# 换密钥 / 换模型有三种方式（详见《API密钥与配置更换指南.md》）：
#   1. 改本文件（.env）      → 重启服务生效
#   2. 改 server/data/config.json → 重启服务生效
#   3. 调 POST /api/config   → 立即热生效，无需重启（App 内设置界面用这个）
# ============================================

# ---- 服务商选择 ----
# 可选：taotoken / openai / dashscope / deepseek / custom
# 选好后只需填 LLM_API_KEY；地址与模型名会自动套用该服务商的预设
LLM_PROVIDER=taotoken

# ---- API 密钥（唯一必填项）----
LLM_API_KEY=sk-your-key-here

# ---- 以下均为可选；不填则自动使用所选服务商的预设值 ----
# 接口地址：必须兼容 OpenAI 协议，以 /v1 结尾
# LLM_BASE_URL=https://api.taotoken.net/v1
# 视觉识别模型：必须支持图片输入（image_url）
# MODEL_VISION=glm-5.3-flash
# 文本生成模型：需要长文本生成能力
# MODEL_TEXT=deepseek-v4-pro

# ---- 服务端口 ----
PORT=3000

# ---- App / 分域部署相关（Web 阶段可不管）----
# 允许的跨域来源，打包 App 时建议改为具体来源，如 capacitor://localhost
# ALLOW_ORIGIN=*
# 修改配置的口令：设置后 POST /api/config 必须带 X-Config-Token 头
# CONFIG_TOKEN=

# ============================================
# 兼容旧变量名：TAOTOKEN_API_KEY / TAOTOKEN_BASE_URL 仍可识别，
# 但建议迁移到上面的 LLM_* 命名（换服务商时语义更清楚）
# TAOTOKEN_API_KEY=sk-xxx
# TAOTOKEN_BASE_URL=https://api.taotoken.net/v1
# ============================================
